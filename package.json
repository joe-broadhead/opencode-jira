{
  "name": "@joe-broadhead/opencode-jira",
  "version": "0.0.0",
  "description": "Unofficial OpenCode plugin for Jira: find and read work items, boards and sprints, and make selected changes, through Atlassian's official MCP server",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jira"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-jira.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-jira#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-jira/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "atlassian",
      "name": "Atlassian",
      "domain": "atlassian.com"
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "drift": "node scripts/check-jira-tools.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
